msgstr "Sodom Burns"

#: scripts/meta/forge_tree.gd:48
msgid "Les armes sortent du feu plus mordantes."
msgstr "Weapons come out of the fire with more bite."

#: scripts/meta/forge_tree.gd:53
msgid "Le métal garde le tranchant."
msgstr "The metal keeps its edge."

#: scripts/meta/forge_tree.gd:58
msgid "Plus rien ne grippe."
msgstr "Nothing jams anymore."

#: scripts/meta/forge_tree.gd:63
msgid "Trouve la faille plus souvent."
msgstr "Finds the gap more often."

#: scripts/meta/forge_tree.gd:68
msgid "Forgé dans quelque chose de très ancien."
msgstr "Forged in something very old."

#: scripts/meta/forge_tree.gd:74
msgid "Les traits ne s'arrêtent plus au premier corps."
msgstr "Your bolts no longer stop at the first body."

#: scripts/meta/forge_tree.gd:79
msgid "Ce qui reste quand tout le reste a brûlé."
msgstr "What remains when everything else has burned."

#: scripts/meta/forge_tree.gd:86
msgid "Une couche de plus entre vous et eux."
msgstr "One more layer between you and them."

#: scripts/meta/forge_tree.gd:91
msgid "Ça pèse, mais ça tient."
msgstr "It's heavy, but it holds."

#: scripts/meta/forge_tree.gd:96
msgid "Les plaies se referment d'elles-mêmes."
msgstr "Wounds close on their own."

#: scripts/meta/forge_tree.gd:101
msgid "Il en faut plus pour vous abattre."
msgstr "It takes more to bring you down."

#: scripts/meta/forge_tree.gd:106
msgid "Trempée dans la même cuve que les armes."
msgstr "Quenched in the same vat as the weapons."

#: scripts/meta/forge_tree.gd:112
msgid "Abattre un boss soigne deux fois plus : l'équivalent de 4 coups ennemis au lieu de 2."
msgstr "Slaying a boss heals twice as much: the equivalent of 4 enemy hits instead of 2."

#: scripts/meta/forge_tree.gd:118
msgid "Une fois par run, le coup fatal vous relève à mi-vie au lieu de vous achever."
msgstr "Once per run, the killing blow leaves you standing at half health instead of finishing you."

#: scripts/meta/forge_tree.gd:126
msgid "Les âmes se laissent mieux saisir."
msgstr "Souls are easier to grasp."

#: scripts/meta/forge_tree.gd:131
msgid "La cendre ne ralentit plus."
msgstr "Ash no longer slows you down."

#: scripts/meta/forge_tree.gd:136
msgid "La boutique baisse ses prix de 10 %."
msgstr "The shop lowers its prices by 10%."

#: scripts/meta/forge_tree.gd:142
msgid "La boutique propose de meilleures raretés."
msgstr "The shop offers better rarities."

#: scripts/meta/forge_tree.gd:148
msgid "Chaque run commence avec 60 âmes."
msgstr "Every run starts with 60 souls."

#: scripts/meta/forge_tree.gd:154
msgid "La boutique propose un objet de plus."
msgstr "The shop offers one more item."

#: scripts/meta/forge_tree.gd:160
msgid "Chaque boss abattu laisse une clé de plus."
msgstr "Every boss slain drops one more key."

#: scripts/meta/forge_tree.gd:184
msgid "La Marque monte de 1,5 % par élimination au lieu de 1 %."
msgstr "The Mark grows by 1.5% per kill instead of 1%."

#: scripts/meta/forge_tree.gd:191
msgid "La Marque plafonne à +45 % au lieu de +25 %."
msgstr "The Mark caps at +45% instead of +25%."

#: scripts/meta/forge_tree.gd:198
msgid "La Marque ne retombe qu'à moitié entre deux vagues."
msgstr "The Mark only drops by half between waves."

#: scripts/meta/forge_tree.gd:205
msgid "La Marque donne aussi la moitié de sa valeur en cadence de tir."
msgstr "The Mark also grants half its value as fire rate."

#: scripts/meta/forge_tree.gd:212
msgid "Les ennemis sous 12 % de vie meurent sur le coup. Les boss sont épargnés."
msgstr "Enemies below 12% health die instantly. Bosses are spared."

#: scripts/meta/forge_tree.gd:221
msgid "Chaque coup encaissé rend des âmes : une pour cinq points de dégâts."
msgstr "Every hit you take gives back souls: one per five points of damage."

#: scripts/meta/forge_tree.gd:235
msgid "Ce qui a déjà été brisé se répare plus dur."
msgstr "What has been broken before mends harder."

#: scripts/meta/forge_tree.gd:245
msgid "+0,8 % de dégâts par point d'armure."
msgstr "+0.8% damage per point of armor."

#: scripts/meta/forge_tree.gd:273
msgid "La Consécration s'étend d'un tiers et brûle moitié plus fort."
msgstr "Consecration spreads a third wider and burns half again as hard."

#: scripts/meta/forge_tree.gd:287
msgid "Le sol se consacre dès l'arrêt et y soigne le double. Le Jugement ne demande que deux charges."
msgstr "The ground is consecrated the moment he stops, and heals twice as much there. Judgment needs only two charges."

#: scripts/meta/forge_tree.gd:296
msgid "On ne s'arrête pas sur des braises."
msgstr "You don't stop on hot coals."

#: scripts/meta/forge_tree.gd:302
msgid "Le bonus de cadence en mouvement double : +20 % → +40 %."
msgstr "The fire rate bonus while moving doubles: +20% → +40%."

#: scripts/meta/forge_tree.gd:309
msgid "Il ne part jamais les mains vides."
msgstr "He never leaves empty-handed."

#: scripts/meta/forge_tree.gd:315
msgid "+20 % de dégâts tant qu'il se déplace."
msgstr "+20% damage while moving."

#: scripts/meta/forge_tree.gd:326
msgid "Les ennemis que vous tuez explosent."
msgstr "The enemies you kill explode."

