#: scripts/systems/curse_system.gd:58
msgid "Rituel de sang"
msgstr "Blood Rite"

#: scripts/systems/curse_system.gd:66
msgid "Œil du vide"
msgstr "Eye of the Void"

#: scripts/systems/curse_system.gd:27
msgid "Les démons ont senti quelque chose."
msgstr "The demons have caught a scent."

#: scripts/systems/curse_system.gd:35
msgid "Leur peau a cuit trop longtemps."
msgstr "Their skin has baked too long."

#: scripts/systems/curse_system.gd:43
msgid "Il en sort toujours davantage."
msgstr "There are always more of them."

#: scripts/systems/curse_system.gd:52
msgid "Vous êtes venu sans armure."
msgstr "You came without armor."

#: scripts/systems/curse_system.gd:59
msgid "Chaque coup porte plus loin qu'il ne devrait."
msgstr "Every blow lands harder than it should."

#: scripts/systems/curse_system.gd:67
msgid "Les grands sont là dès le début."
msgstr "The big ones are here from the start."

#: scripts/systems/curse_system.gd:28
msgid "Ennemis +30 % de vitesse"
msgstr "Enemies +30% speed"

#: scripts/systems/curse_system.gd:36
msgid "Ennemis +50 % de PV"
msgstr "Enemies +50% HP"

#: scripts/systems/curse_system.gd:44
msgid "+35 % d'ennemis"
msgstr "+35% enemies"

#: scripts/systems/curse_system.gd:53
msgid "-30 PV max"
msgstr "-30 max HP"

#: scripts/systems/curse_system.gd:60
msgid "Ennemis +45 % de dégâts"
msgstr "Enemies +45% damage"

#: scripts/systems/curse_system.gd:68
msgid "Élites dès la vague 1, deux fois plus fréquentes"
msgstr "Elites from wave 1, twice as often"

#: scripts/systems/wave_modifiers.gd:22
msgid "Chairs volatiles"
msgstr "Volatile Flesh"

#: scripts/systems/wave_modifiers.gd:29
